{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "url": ["http://localhost:3001/"],
      "settings": {
        "onlyCategories": ["accessibility"],
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless=new --disable-gpu"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
