{
  "name": "@revealui-studio/agency",
  "version": "0.3.0",
  "description": "RevealUI Studio agency site — services, case studies, hire-us. Hosted at revealuistudio.com.",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/RevealUIStudio/agency.git"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@revealui/contracts": "^0.8.0",
    "@revealui/presentation": "^0.13.1",
    "@revealui/router": "^0.3.11",
    "@sentry/react": "^10.74.0",
    "@vercel/speed-insights": "^2.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@changesets/cli": "^2.31.1",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "29.1.1",
    "tailwindcss": "^4.3.2",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "build": "vite build",
    "changeset": "changeset",
    "changeset:status": "changeset status --since=origin/main",
    "changeset:version": "changeset version",
    "clean": "rm -rf dist",
    "dev": "vite dev --port 3001",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "preview": "vite preview --port 3001",
    "start": "vite preview --port 3001",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --coverage.reporter=json-summary --coverage.reporter=html --coverage.reporter=text",
    "typecheck": "tsc --noEmit"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": ">=2.0.5",
      "hono": "4.13.8",
      "vitest": ">=4.1.11 <5",
      "@vitest/mocker": ">=4.1.11 <5",
      "@vitest/coverage-v8": ">=4.1.11 <5",
      "postcss": "8.5.25",
      "nanoid@<3.3.18": "3.3.18",
      "undici": ">=7.29.0 <8",
      "vite": "8.2.0",
      "typescript": "7.0.2"
    }
  },
  "packageManager": "pnpm@10.28.2"
}
