{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "ignoreCommand": "node scripts/vercel-ignored-build-step.mjs",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://va.vercel-scripts.com https://revealui-umami.fly.dev; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://api.revealui.com; font-src 'self' data:; connect-src 'self' https://api.revealui.com https://vitals.vercel-insights.com https://revealui-umami.fly.dev https://*.ingest.sentry.io https://*.ingest.us.sentry.io; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/.well-known/security.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/proof-gap-checklist.pdf",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.revealuistudio.com" }],
      "destination": "https://revealuistudio.com/:path*",
      "permanent": true
    },
    {
      "source": "/pricing",
      "destination": "/#calculator",
      "permanent": true
    },
    {
      "source": "/products",
      "destination": "/#calculator",
      "permanent": true
    },
    {
      "source": "/catalog",
      "destination": "/#calculator",
      "permanent": true
    },
    {
      "source": "/blog/01-why-we-built-revealui",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/02-http-402-payments",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/03-multi-agent-coordination",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/04-local-first-ai-stack",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/05-five-primitives",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/06-open-source-and-pro",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/07-agent-first-future",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/08-getting-started",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/09-component-library",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/10-own-your-data",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/11-revealfleet-product-family",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/12-own-your-secrets",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/13-zero-regex",
      "destination": "/blog/zero-regex",
      "permanent": true
    },
    {
      "source": "/blog/14-claim-drift",
      "destination": "/blog/claim-drift",
      "permanent": true
    },
    {
      "source": "/blog/15-dashboard-agent-chat",
      "destination": "/blog/dashboard-agent-chat",
      "permanent": true
    },
    {
      "source": "/blog/16-ui-of-the-future",
      "destination": "/blog/ui-of-the-future",
      "permanent": true
    },
    {
      "source": "/blog/17-shareable-upside",
      "destination": "/blog/shareable-upside",
      "permanent": true
    },
    {
      "source": "/blog/18-open-runtime-for-fde-work",
      "destination": "/blog/open-runtime-for-fde-work",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/og-card.png", "destination": "/og-card.png" },
    { "source": "/proof-gap-checklist.pdf", "destination": "/proof-gap-checklist.pdf" },
    { "source": "/.well-known/(.*)", "destination": "/.well-known/$1" },
    { "source": "/api/share/:slug/:file", "destination": "/api/share?slug=:slug&file=:file" },
    { "source": "/share/:slug/:file", "destination": "/api/share?slug=:slug&file=:file" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
